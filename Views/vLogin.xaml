<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="eclavijoS3i.Views.vLogin"
             Title="vLogin">

    <ContentPage.Resources>
        <Style x:Key="styleLabel" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="BackgroundColor" Value="Red"/>
            <Setter Property="TextColor" Value="Blue" />
        </Style>

        <Style x:Key="styleEntry" TargetType="Entry">
            <Setter Property="Background" Value="Beige" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </ContentPage.Resources>
    
    <VerticalStackLayout 
        Padding="20"
        Spacing="15"
        BackgroundColor="Gray">
        <Label 
            Text="INICIO DE SESION"
            FontSize="20"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        
        <!--Image-->
        <!--1. enlace web jpg o png-->
        <!--2. archivo local jpg o png-->
        <Image 
            Source="login.jpg"
            HeightRequest="150"
            WidthRequest="150"
            HorizontalOptions="Center" />
        

        <Grid HorizontalOptions="Center"
              VerticalOptions="Center"
              RowSpacing="10"
              ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <Label Text="Usuario:"
                   Style="{StaticResource styleLabel}"
                   FontSize="16"
                   Grid.Row="0" Grid.Column="0" VerticalOptions="Center" />

            <Entry x:Name="txtUsuario"
                   Placeholder="Ingresa el usuario"
                   Style="{StaticResource styleEntry}"
                   Grid.Row="0"
                   Grid.Column="1"/>
            
            <Label Text="Contraseña:"
                   Style="{StaticResource styleLabel}"
                   FontSize="18"
                   Grid.Row="1"
                   Grid.Column="0"/>

            <Entry x:Name="txtcontrasena"
                   Placeholder="Ingresa la contraseña"
                   Style="{StaticResource styleEntry}"
                   IsPassword="True"
                   Grid.Row="1"
                   Grid.Column="1"/>

            <Button x:Name="btnIniciarSesion"
                    Style="{StaticResource BotonGlobal}"
                    Text="Iniciar Sesion"
                    Clicked="btnIniciarSesion_Clicked"
                    Grid.Row="2"
                    Grid.Column="0"/>

            <Button x:Name="btnRegistrarUsuario"
                    Text="Registra Usuario"
                    Clicked="btnRegistrarUsuario_Clicked"
                    Grid.Row="2"
                    Grid.Column="1"/>
        </Grid>





    </VerticalStackLayout>
</ContentPage>